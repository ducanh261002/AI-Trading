# Trang chính 3D tự phân tích, không mở vị thế mới
ATC_OBSERVER_MODE=true
DOMAIN=trading.example.com
ACME_EMAIL=owner@example.com
ATC_PUBLIC_ORIGIN=https://trading.example.com
# Generate with: docker run --rm -it ai-trading-web:latest python -m app.ops hash-password
ATC_ADMIN_PASSWORD_HASH=
ATC_HOSTED=true
ATC_MODE=paper
ATC_MARKET_ENABLED=true
ATC_MARKET_SYMBOLS=BTCUSDT,ETHUSDT
ATC_CANDLE_LIMIT=500
ATC_AGENTS_ENABLED=true
ATC_AGENT_AUTO_SECONDS=0
ATC_PAPER_AUTO=false
ATC_STRATEGY=consensus
ATC_OLLAMA_ENABLED=false
ATC_RISK_PER_TRADE=0.005
ATC_DAILY_LOSS_LIMIT=0.02
ATC_MAX_DRAWDOWN=0.10
ATC_MAX_POSITIONS=3
ATC_MAX_EXPOSURE=1.0
ATC_MAX_LEVERAGE=2
ATC_PAPER_INITIAL_BALANCE=10000
ATC_FEE_RATE=0.0005
ATC_SLIPPAGE_RATE=0.0002
ATC_FUNDING_RATE=0.0001
COMPOSE_PROJECT_NAME=ai-trading
ATC_NEWS_FEED_URL=
