# Trang chính 3D tự phân tích, không mở vị thế mới
ATC_OBSERVER_MODE=true
ATC_MODE=paper
ATC_DATABASE_PATH=data/command_center.sqlite3
ATC_RISK_PER_TRADE=0.005
ATC_DAILY_LOSS_LIMIT=0.02
ATC_MAX_DRAWDOWN=0.10
ATC_MAX_POSITIONS=3
ATC_MAX_EXPOSURE=1.0
ATC_MAX_LEVERAGE=2
ATC_OLLAMA_URL=http://127.0.0.1:11434
ATC_OLLAMA_MODEL=qwen2.5:3b
ATC_MARKET_ENABLED=true
ATC_MARKET_SYMBOLS=BTCUSDT,ETHUSDT
ATC_MARKET_STALE_SECONDS=15
ATC_CANDLE_LIMIT=200
ATC_AGENTS_ENABLED=true
ATC_AGENT_TASK_TIMEOUT=45
# 0: manual cycles only; automatic mode accepts 30..3600 seconds.
ATC_AGENT_AUTO_SECONDS=0
ATC_OLLAMA_ENABLED=false
# Reserved for phase 5; never expose these to the UI or LLM.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Cloud website: use deploy/cloud.env.example instead of this local file.
ATC_HOSTED=false
ATC_PUBLIC_ORIGIN=http://127.0.0.1:8000
ATC_ADMIN_PASSWORD_HASH=
ATC_PAPER_INITIAL_BALANCE=10000
ATC_PAPER_AUTO=false
ATC_STRATEGY=consensus
ATC_FEE_RATE=0.0005
ATC_SLIPPAGE_RATE=0.0002
ATC_FUNDING_RATE=0.0001
ATC_MAX_ENTRY_DEVIATION=0.002
# Optional public HTTPS RSS/Atom feed; external text never controls trading.
ATC_NEWS_FEED_URL=
